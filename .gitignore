# Uploads runtime (dibuat otomatis saat server jalan) — keep folder, ignore isi
# Struktur dipertahankan via .gitkeep agar fresh clone langsung jalan
uploads/*
!uploads/.gitkeep
!uploads/.gitignore
!uploads/check/
!uploads/ocr/
!uploads/references/
uploads/check/*
!uploads/check/.gitkeep
!uploads/check/.gitignore
uploads/ocr/*
!uploads/ocr/.gitkeep
uploads/references/*
!uploads/references/.gitkeep
uploads/references_backup/
uploads/_bench_native/
uploads/_bench_native/
tests/ocr_bench/
uploads/*.png
uploads/*.jpg
uploads/*.jpeg
uploads/*.json
uploads/*.jsonl
uploads/ocr/*.json
uploads/callback_log.jsonl
uploads/callback_dead_letter.jsonl

