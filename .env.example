# .env.example â€” Template environment untuk FastAPI OCR + Callback Laravel
# Copy file ini menjadi .env dan isi nilai real:  copy .env.example .env  (Windows) / cp .env.example .env (Linux)
# JANGAN commit .env ke git (sudah ada di .gitignore). Hanya .env.example yang di-commit.

# ---------------------------------------------------------------------------
# FastAPI / OCR
# ---------------------------------------------------------------------------
# Bahasa Tesseract (default eng). Tidak perlu diubah jika hanya eng.
TESSERACT_LANG=eng

# --- OCR Engine (2026-09-11 / OCR_ENGINE_UPGRADE) ---
# paddle = RapidOCR ONNX (default) | vitstr = ViTSTR-Tiny (ultra-cepat) | surya = Surya OCR (presisi tinggi) | tesseract = fallback
OCR_ENGINE=paddle
OCR_DET_THRESHOLD=0.5
OCR_REC_THRESHOLD=0.5
OCR_MIN_TEXT_LEN=1
OCR_MODEL_DIR=

# --- OCR Tuning RapidOCR (2026-09-12 / PADDLEOCR_NATIVE_PLAN Â§6.0 FALLBACK opsi B+C) ---
# RAPIDOCR_REC_MODEL=medium (default, akurat ~4-5s, fix H->K, multilingual 50 bahasa)
#   | small (cepat ~1s, fallback). BUTUH RESTART setelah diubah.
# Lihat plans/PADDLEOCR_NATIVE_MIGRATION_PLAN.md.
RAPIDOCR_REC_MODEL=medium
RAPIDOCR_REC_VERSION=PP-OCRv6
RAPIDOCR_REC_LANG=en
RAPIDOCR_DET_VERSION=PP-OCRv6
RAPIDOCR_DET_MODEL=small
RAPIDOCR_BOX_THRESH=0.5
RAPIDOCR_TEXT_SCORE=0.5
RAPIDOCR_UNCLIP_RATIO=1.6

# --- Compare Similarity Teks OCR (2026-09-12 / COMPARE_TEXT_SIMILARITY_PLAN) ---
# reference vs slot (difflib, <5ms). PASS >= threshold, else FAIL.
SIMILARITY_ENABLED=true
SIMILARITY_PASS_THRESHOLD=0.85
# Toleransi tanda baca/spasi (2026-10-09): true = titik/koma/strip/spasi diabaikan
# pada skor+diff; KEEP_DECIMAL=true melindungi angka desimal ("1.5" vs "15" beda).
# BUTUH RESTART. Rollback = false + restart (perilaku lama).
SIMILARITY_CANONICAL_PUNCT=true
SIMILARITY_KEEP_DECIMAL=true
# Engine compare teks: rapidfuzz (baru, default) | difflib (lama, rollback).
SIMILARITY_ENGINE=rapidfuzz
# Content-gate beda konten: PASS→FAIL bila fraksi kata tak-terjelaskan > 0.08
# (beda label/ukuran, bukan typo OCR). false = nonaktif. BUTUH RESTART.
SIMILARITY_CONTENT_GATE=true
SIMILARITY_MAX_ORPHAN_FRACTION=0.08
SIMILARITY_ORPHAN_SIM_MIN=0.6

# ---------------------------------------------------------------------------
# OCR Optimization (2026-10-06 / OCR_OPTIMIZATION_PLAN R1-R10, 6-core target)
# Semua opt-in; kosongkan/hapus = default di app/config.py (perilaku lama).
# BUTUH RESTART setelah diubah. Rollback = ubah + restart.
# ---------------------------------------------------------------------------
# R1 warm-up agar request pertama ~= steady-state
OCR_WARMUP=true
# R2 batas sisi terpanjang pre-resize (0=nonaktif). Mulai konservatif 1600,
# turunkan bertahap 1280 -> 960 bila critical_lines tetap lolos.
OCR_MAX_SIDE_PX=1600
# R2 batas sisi deteksi RapidOCR (Det.limit_side_len, limit_type=max)
OCR_DET_LIMIT_SIDE=960
# R4 long-poll maks detik untuk GET /ocr/{fn}?wait=
OCR_LONGPOLL_MAX_SECONDS=10
# FIX timeout Label 1/2 (2026-10-06): batas panjang + durable re-attach.
# Memory LRU agar Cek Lagi tetap ketemu (default 20). Fresh-pending agar redirect
# polling race tidak 404 selama 180s (menutup frontend 120s + Laravel 150s).
OCR_MAX_MEMORY_RESULTS=20
OCR_PENDING_FRESH_SECONDS=180
# R5 pool callback terpisah (jangan samakan dengan OCR_WORKERS)
CALLBACK_WORKERS=2
# R6 concurrency: 2 worker x 3 thread ONNX ideal untuk 6 core.
# Batch 5: ~5x serial -> ~2.5-3x paralel. Jangan uvicorn --workers >1.
OCR_WORKERS=2
OCR_QUEUE_MAX=20
# 0=auto (core // OCR_WORKERS). Isi manual bila benchmark butuh (mis. 3).
OCR_ORT_INTRA_THREADS=0
OCR_ORT_INTER_THREADS=1
# R7 cascade small->medium selektif (default OFF; ON bila rec dominan & R2 kurang)
OCR_CASCADE_ENABLED=false
OCR_CASCADE_CONF=0.90
OCR_CASCADE_REC_MODEL=medium
# R8 angle classifier (false = lebih cepat, tapi label terbalik gagal)
OCR_USE_CLS=true
# R10 fallback Tesseract: timeout detik + batas sisi pre-upscale
OCR_TESSERACT_TIMEOUT_SECONDS=10
OCR_TESSERACT_MAX_SIDE=2500
# Fase 0 observability: sertakan timings/image_scale/ocr_config di hasil
OCR_TIMINGS_ENABLED=true

# ---------------------------------------------------------------------------
# Callback ke Laravel (PUSH cleaned_text) â€” Fix Retake 401 (2026-09-06)
# WAJIB Sinkron 3 variabel dengan Laravel .env (JANGAN isi nilai real di sini):
#   OCR_CALLBACK_API_KEY / LARAVEL_API_KEY = YOUR_API_KEY_HERE (32 char random)
#   OCR_CALLBACK_SECRET  / LARAVEL_HMAC_SECRET = YOUR_HMAC_SECRET_HERE (64 char hex)
#   OCR_CALLBACK_URL     / LARAVEL_CALLBACK_URL = http://127.0.0.1:8000/api/ocr/callback
# FastAPI support fallback: LARAVEL_API_KEY -> OCR_CALLBACK_API_KEY -> FASTAPI_API_KEY
# ---------------------------------------------------------------------------
# Primary (Laravel expects OCR_CALLBACK_* alias, but LARAVEL_* is canonical in FastAPI)
OCR_CALLBACK_API_KEY=YOUR_API_KEY_HERE
OCR_CALLBACK_SECRET=YOUR_HMAC_SECRET_HERE
OCR_CALLBACK_URL=http://127.0.0.1:8000/api/ocr/callback
# Canonical (FastAPI config reads this)
LARAVEL_CALLBACK_URL=http://127.0.0.1:8000/api/ocr/callback
LARAVEL_API_KEY=YOUR_API_KEY_HERE
LARAVEL_HMAC_SECRET=YOUR_HMAC_SECRET_HERE
# Legacy fallback (jangan hapus, untuk transisi)
FASTAPI_API_KEY=YOUR_API_KEY_HERE

# Contoh generate random (jika rotate key):
# -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# -join ((48..57)+(97..102) | Get-Random -Count 64 | ForEach-Object {[char]$_})

# Enable/disable callback. Set false untuk testing tanpa Laravel.
CALLBACK_ENABLED=true

# Timeout HTTP callback (detik). Connect timeout fixed 2s.
CALLBACK_TIMEOUT_SECONDS=5.0

# Jumlah retry jika Laravel 5xx/timeout/429 (exponential backoff 2/4/8s + jitter)
CALLBACK_RETRIES=3
CALLBACK_RETRY_BACKOFF_BASE=2.0

# Jika true, kirim raw_text juga (boros). Default false = hanya cleaned_text + lines.
CALLBACK_INCLUDE_RAW_TEXT=false

# Jika true, kirim juga saat OCR status failed (untuk alert). Default false.
CALLBACK_SEND_ON_FAILED=false

# Allowlist host callback untuk cegah SSRF (comma-separated). Kosongkan untuk disable allowlist.
CALLBACK_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Retake Capture Cleanup (anti-stale & hemat storage)
# ---------------------------------------------------------------------------
# Jika true: setiap POST baru hapus file lama di uploads/ dan ocr/ (hanya simpan terbaru)
CLEANUP_RETAKE=true
# Jumlah file terbaru yang dipertahankan (5 = 1 sesi split dual-side isi 4 label + 1 margin; 1 = hanya terbaru, khusus single-flow)
RETAIN_COUNT=5

# ---------------------------------------------------------------------------
# Rate Limiting â€” Ideal 429 handling (Â§11 Penanganan 429 Too Many Requests)
# ---------------------------------------------------------------------------
# POST /api/test/status burst 5/60 (FIX 429 dual-side front+back, 2026-09-15)
# Dulu 1 gambar/menit â†’ BACK selalu 429. Sekarang 5/menit:
# preview front+back (2) + forward save front+back (2) + 1 retake cadangan.
# Spam 6+/menit masih 429 + Retry-After. BUTUH RESTART setelah diubah.
POST_RATE_LIMIT_REQUESTS=5
POST_RATE_LIMIT_WINDOW_SECONDS=60
# GET polling (ocr/latest, ocr/{filename}, status, files, image): longgar 120 req/60s
#   Dual polling 2 sisi Ã— 10 poll + Choose thumbs berbagi 1 bucket â†’ 60 mepet, 120 aman.
#   Polling ideal tetap: Frontend & Laravel poll hanya 1 URL spesifik per poll.
#   Jika client kena 429: hormati Retry-After header, backoff exponential 2/4/8s + jitter, jangan spam.
GET_RATE_LIMIT_REQUESTS=120
GET_RATE_LIMIT_WINDOW_SECONDS=60
# DELETE untuk Laravel retakeCleanup (best effort, 30/min cegah abuse)
DELETE_RATE_LIMIT_REQUESTS=30
DELETE_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Filesystem External (10.4) â€” Laravel â†” FastAPI
# ---------------------------------------------------------------------------
# Struktur FastAPI:
#   uploads/label-ref-*.png        -> input capture (POST /api/test/status, simpan sebagai label-*.png)
#   uploads/ocr/label-*.png.json   -> hasil OCR (GET /api/test/ocr/{filename})
#   ocr/latest?filename=           -> query spesifik (GET /api/test/ocr/latest?filename=xxx)
# Laravel retakeCleanup: DELETE /api/test/ocr/{original_filename} + DELETE /api/test/status?filename={fn}
#   FastAPI implement dengan verifikasi X-API-Key == LARAVEL_API_KEY, sanitasi basename, hapus 3 lokasi
OCR_LATEST_ALLOW_FILENAME_QUERY=true

# ---------------------------------------------------------------------------
# Check Batch â€” 5 Images (Laravel -> FastAPI) â€” PLAN_CHECK_5_IMAGES (2026-09-07)
# Sinkron dengan Laravel .env: CHECK_EXTERNAL_URL=http://127.0.0.1:9000/api/check/captures
# dan OCR_CALLBACK_API_KEY / CHECK_EXTERNAL_API_KEY harus sama dengan FastAPI CHECK_API_KEY
# ---------------------------------------------------------------------------
CHECK_API_KEY=YOUR_API_KEY_HERE
CHECK_UPLOAD_ROOT=uploads/check
CHECK_MAX_FILE_SIZE=5242880
CHECK_ALLOWED_MIMES=image/png,image/jpeg

# ---------------------------------------------------------------------------
# Check OCR Batch + Checking Label 2-capture (PLAN_CHECK_OCR_5_LABEL_PROCESS +
# PLAN_CHECKING_LABEL_2_CAPTURE_OCR_CALLBACK)
# Callback khusus Checking Label 1/2 (fallback otomatis ke /api/ocr/callback
# bila tidak diisi — lihat app/config.py:247). Laravel: POST /api/check/ocr/callback
# ---------------------------------------------------------------------------
CHECK_OCR_ENABLED=true
CHECK_OCR_MAX_WORKERS=1
CHECK_OCR_TIMEOUT_SECONDS=15
CHECK_PROCESS_RATE_LIMIT_REQUESTS=10
CHECK_PROCESS_RATE_LIMIT_WINDOW_SECONDS=60
CHECK_OCR_CALLBACK_ENABLED=true
CHECK_OCR_CALLBACK_URL=http://127.0.0.1:8000/api/check/ocr/callback
# Progressive callback per-slot (PLAN_PROGRESSIVE_COMPARE_AND_ASYNC_CALLBACK_PER_LABEL).
# true = streaming tiap slot selesai + summary batch_completed (default).
# false = rollback ke perilaku lama (borongan sinkron di akhir). BUTUH RESTART.
CHECK_OCR_PROGRESSIVE_CALLBACK=true

# ---------------------------------------------------------------------------
# Visual Comparison (Gemini 1.5 Flash) â€” PLAN_VISUAL_COMPARISON_GEMINI
# ---------------------------------------------------------------------------
# API key dari Google AI Studio (jangan commit .env real, hanya template di sini)
# [OCR-REENABLE 2026-09-11] Default OFF â€” mode OCR aktif, Gemini nonaktif sementara.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_COMPARE_TIMEOUT=30
GEMINI_COMPARE_ENABLED=false

# ---------------------------------------------------------------------------
# Visual Compare Mode (hasil compare â†’ Laravel) â€” PLAN_VISUAL_COMPARE_MODE
# ---------------------------------------------------------------------------
CHECK_COMPARE_CALLBACK_URL=http://127.0.0.1:8000/api/check/compare/callback
CHECK_COMPARE_CALLBACK_ENABLED=false

# ---------------------------------------------------------------------------
# Reference Library â€” Label Acuan Permanen (PLAN_REFERENCE_LIBRARY_FASTAPI)
# ---------------------------------------------------------------------------
REF_MAX_IMAGE_DIM=1280
REF_THUMB_DIM=320
REF_JPG_QUALITY=82
REF_THUMB_QUALITY=70
REF_MAX_COUNT=2000
REF_MAX_BYTES_MB=2048
REF_RATE_LIMIT_REQUESTS=60
REF_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Reference MySQL backend (PLAN_MYSQL_BACKED_REFERENCE_STORAGE)
# Password ASLI hanya di .env (jangan isi nilai real di sini)
# ---------------------------------------------------------------------------
REF_STORE=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=label_inspection
MYSQL_USER=root
MYSQL_PASSWORD=xxxx
MYSQL_POOL_SIZE=5
OCR_DISK_PERSIST=false
